# ============================================================
#  pg-baseera — environment configuration
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ============================================================

# PostgreSQL (Mode A: full stack)
# Used when you want pg-baseera to spin up its own PostgreSQL.
# Ignored in Mode B (external DB).
POSTGRES_DB=appdb
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=changeme

# Exporter credentials
# A read-only monitoring user created in your PostgreSQL.
# Mode A: created automatically via postgres/init/01_exporter_user.sql
# Mode B: create this user manually in your existing DB first.
#   See docs/external-db-setup.sql for the exact commands.
EXPORTER_USER=pgexporter
EXPORTER_PASSWORD=changeme

# External DB (Mode B only)
# Full DSN to your existing PostgreSQL instance.
# Leave blank if using Mode A (internal postgres container).
# Examples:
#   postgresql://pgexporter:pass@myhost:5432/mydb?sslmode=require
#   postgresql://pgexporter:pass@rds-endpoint.amazonaws.com:5432/mydb?sslmode=require
EXTERNAL_DB_DSN=

# Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme

# pgBadger
# How often to regenerate the HTML report (seconds)
PGBADGER_INTERVAL=3600

# pgBench load testing.
# Set to "true" to enable pgbench load simulation.
# Only works in Mode A (requires internal postgres container).
# For using external PostgreSQL, set it to "false"
PGBENCH_ENABLED=true
PGBENCH_CLIENTS=20
PGBENCH_THREADS=4
PGBENCH_BURST_DURATION=60
PGBENCH_IDLE_DURATION=240


# ============================================================
#  RDS Extension — Staging
#  Fill these in when monitoring AWS RDS instances
# ============================================================


# AWS credentials (needs CloudWatchReadOnlyAccess and AmazonRDSReadOnlyAccess)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=eu-central-1


# Staging primary
RDS_STAGING_PRIMARY_HOST=staging-rds-pg.xxxxxxxx.region.rds.amazonaws.com
RDS_STAGING_PRIMARY_PORT=5432
RDS_STAGING_PRIMARY_DB=main


# Staging replica
RDS_STAGING_REPLICA_HOST=staging-rds-pg-replica.xxxxxxxx.region.rds.amazonaws.com
RDS_STAGING_REPLICA_PORT=5432
RDS_STAGING_REPLICA_DB=main


# Monitoring user (created via docs/external-db-setup.sql on the RDS instance)
RDS_EXPORTER_USER=pgexporter
RDS_EXPORTER_PASSWORD=changeme


# CloudWatch log groups
RDS_STAGING_PRIMARY_LOG_GROUP=/aws/rds/instance/staging-rds-pg/postgresql
RDS_STAGING_REPLICA_LOG_GROUP=/aws/rds/instance/staging-rds-pg-replica/postgresql


# pgBadger log sync interval in seconds (how often to pull logs from CloudWatch)
RDS_LOG_SYNC_INTERVAL=3600

# Alertmanager
ALERTMANAGER_PORT=9093
# Uncomment and set when Slack webhook is ready:
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

{
  "title": "PostgreSQL Monitoring — pg-baseera",
  "uid": "pg-monitor-01",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "type": "stat", "title": "Active Connections",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(pg_stat_database_numbackends{datname=\"appdb\"})", "legendFormat": "Connections" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "yellow", "value": 50 },
        { "color": "red", "value": 80 }
      ]}}}
    },
    {
      "id": 2, "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "type": "stat", "title": "Cache Hit Ratio %",
      "datasource": "Prometheus",
      "targets": [{ "expr": "round(sum(pg_stat_database_blks_hit{datname=\"appdb\"}) / (sum(pg_stat_database_blks_hit{datname=\"appdb\"}) + sum(pg_stat_database_blks_read{datname=\"appdb\"}) + 1) * 100, 0.01)", "legendFormat": "Cache Hit %" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [
        { "color": "red", "value": null },
        { "color": "yellow", "value": 90 },
        { "color": "green", "value": 99 }
      ]}}}
    },
    {
      "id": 3, "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "type": "stat", "title": "Database Size",
      "datasource": "Prometheus",
      "targets": [{ "expr": "pg_database_size_bytes{datname=\"appdb\"}", "legendFormat": "Size" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "bytes" }}
    },
    {
      "id": 4, "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "type": "stat", "title": "Deadlocks / 1h",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(increase(pg_stat_database_deadlocks{datname=\"appdb\"}[1h]))", "legendFormat": "Deadlocks" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "red", "value": 1 }
      ]}}}
    },
    {
      "id": 5, "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "type": "stat", "title": "TPS (commits/s)",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"appdb\"}[1m]))", "legendFormat": "TPS" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "ops", "thresholds": { "steps": [
        { "color": "blue", "value": null }
      ]}}}
    },
    {
      "id": 6, "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "type": "stat", "title": "Max TX Duration (s)",
      "datasource": "Prometheus",
      "targets": [{ "expr": "pg_stat_activity_max_tx_duration{datname=\"appdb\"}", "legendFormat": "Max TX" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "yellow", "value": 5 },
        { "color": "red", "value": 30 }
      ]}}}
    },
    {
      "id": 7, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "type": "timeseries", "title": "Transactions per Second",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname=\"appdb\"}[1m])", "legendFormat": "Commits/s" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname=\"appdb\"}[1m])", "legendFormat": "Rollbacks/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }}
    },
    {
      "id": 8, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "type": "timeseries", "title": "Rows Activity",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(pg_stat_database_tup_inserted{datname=\"appdb\"}[1m])", "legendFormat": "Inserted/s" },
        { "expr": "rate(pg_stat_database_tup_updated{datname=\"appdb\"}[1m])", "legendFormat": "Updated/s" },
        { "expr": "rate(pg_stat_database_tup_deleted{datname=\"appdb\"}[1m])", "legendFormat": "Deleted/s" },
        { "expr": "rate(pg_stat_database_tup_fetched{datname=\"appdb\"}[1m])", "legendFormat": "Fetched/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "rows/s" }}
    },
    {
      "id": 9, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "type": "timeseries", "title": "Active Connections Over Time",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "pg_stat_database_numbackends{datname=\"appdb\"}", "legendFormat": "Connections" },
        { "expr": "pg_settings_max_connections", "legendFormat": "Max Connections" }
      ]
    },
    {
      "id": 10, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "type": "timeseries", "title": "Cache Hit vs Disk Read",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(pg_stat_database_blks_hit{datname=\"appdb\"}[1m])", "legendFormat": "Cache Hits/s" },
        { "expr": "rate(pg_stat_database_blks_read{datname=\"appdb\"}[1m])", "legendFormat": "Disk Reads/s" }
      ]
    },
    {
      "id": 11, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "type": "timeseries", "title": "Buffers Written",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(pg_stat_bgwriter_buffers_checkpoint_total[1m])", "legendFormat": "Checkpoint" },
        { "expr": "rate(pg_stat_bgwriter_buffers_clean_total[1m])", "legendFormat": "BgWriter" },
        { "expr": "rate(pg_stat_bgwriter_buffers_backend_total[1m])", "legendFormat": "Backend" }
      ]
    },
    {
      "id": 12, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "type": "timeseries", "title": "Checkpoints",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(pg_stat_bgwriter_checkpoints_timed_total[5m])", "legendFormat": "Timed" },
        { "expr": "rate(pg_stat_bgwriter_checkpoints_req_total[5m])", "legendFormat": "Requested" }
      ]
    },
    {
      "id": 13, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "type": "timeseries", "title": "Dead Tuples (Top Tables)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "topk(5, pg_table_bloat_n_dead_tup)", "legendFormat": "{{tablename}}" }
      ]
    },
    {
      "id": 14, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "type": "timeseries", "title": "Locks",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum by (mode) (pg_locks_count)", "legendFormat": "{{mode}}" }
      ]
    },
    {
      "id": 15, "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "type": "bargauge", "title": "Table Sizes (Top 10)",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "topk(10, pg_table_bloat_total_bytes)", "legendFormat": "{{schemaname}}.{{tablename}}", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "unit": "bytes" }}
    }
  ]
}
